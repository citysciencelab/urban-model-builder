<div class="umb-editor__titleblock" ...attributes>
  <div class="umb-float umb-titleblock">
    <LinkTo
      @route={{if this.isDemo "index" "models"}}
      class="umb-titleblock__home"
      aria-label={{t
        (if
          this.isDemo
          "components.title_block.back_home"
          "components.title_block.back_library"
        )
      }}
    >
      {{svg-jar "umb-mark" width="24" height="24" aria-hidden="true"}}
    </LinkTo>

    <div class="umb-titleblock__main">
      <span class="umb-titleblock__name">
        {{#if this.isDemo}}
          {{t "general.demo"}}
        {{else}}
          {{@modelVersion.model.internalName}}
        {{/if}}
      </span>
      <span class="umb-meta umb-titleblock__meta">
        <span>
          {{#if @modelVersion.hasVersion}}
            {{@modelVersion.versionString}}
            ·
          {{/if}}
          {{t
            (if
              @modelVersion.isPublished
              "models.model.states.published"
              "models.model.states.draft"
            )
          }}
          {{#if this.showSaveStatus}}
            {{#if this.saveStatus.isSaving}}
              ·
              <span data-test-save-status="saving">
                {{t "components.title_block.saving"}}
              </span>
            {{else if this.saveStatus.hasError}}
              ·
              <span
                class="umb-titleblock__error"
                data-test-save-status="error"
              >
                <SvgIcon @icon="error" @size="xs" />
                {{t "components.title_block.not_saved"}}
              </span>
            {{else if this.saveStatus.lastSavedAt}}
              ·
              <span data-test-save-status="saved">
                {{t
                  "components.title_block.saved_at"
                  time=(format-time
                    this.saveStatus.lastSavedAt hour="2-digit" minute="2-digit"
                  )
                }}
              </span>
            {{/if}}
          {{/if}}
        </span>
        {{#if this.isReadOnly}}
          <span class="umb-chip umb-chip--quiet" data-test-read-only>
            {{t "components.model_info.view_mode"}}
            <BsTooltip
              @title={{t "components.edit_state_badge.view_mode.tooltip"}}
              @placement="bottom"
            />
          </span>
        {{/if}}
        {{#if this.isDemo}}
          <span class="umb-chip umb-chip--draft" data-test-demo>
            {{t "components.edit_state_badge.demo_mode.title"}}
            <BsTooltip
              @title={{t "components.edit_state_badge.demo_mode.tooltip"}}
              @placement="bottom"
            />
          </span>
        {{/if}}
      </span>
    </div>
  </div>
</div>
