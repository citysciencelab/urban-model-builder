{{#let
  (if
    (eq this.intl.primaryLocale "de-de")
    (hash locale="en-us" name="EN")
    (hash locale="de-de" name="DE")
  )
  as |target|
}}
  <button
    type="button"
    class="umb-rail__item"
    lang={{target.locale}}
    title={{t "components.app_rail.language_title"}}
    {{on "click" (fn this.changeLocaleTo target.locale)}}
    ...attributes
  >
    <SvgIcon @icon="language" @size="sm" />
    {{target.name}}
  </button>
{{/let}}
