<div class="simulation-viewer d-flex gap-3" {{did-update this.loadData @reloadKey}}>
  {{#if this.isLoading}}
    <div class="text-center my-5 w-100">
      <BsSpinner />
      <p>Lade Simulationsergebnisse...</p>
    </div>
  {{else if this.error}}
    <BsAlert @type="danger" @visible={{true}} @dismissible={{false}} class="w-100">
      {{this.error}}
    </BsAlert>
  {{else if (eq this.groups.size 0)}}
    <div class="empty-state text-center my-5 w-100">
      <FaIcon @icon="chart-bar" @size="3x" class="text-muted mb-3" />
      <h3>Keine Simulationsergebnisse</h3>
      <p>Führe eine Simulation aus und speichere die Ergebnisse, um sie hier zu vergleichen.</p>
    </div>
  {{else}}
    <div class="simulation-viewer-layout d-flex gap-3 w-100">
      {{!-- Sidebar with groups --}}
      <nav class="simulation-viewer-sidebar flex-shrink-0">
        <div class="sidebar-title fw-bold p-2 border-bottom">Modelle</div>
        <ul class="group-list list-unstyled m-0 p-1">
          {{#each this.groupList as |group|}}
            <li>
              <button
                type="button"
                class="group-item w-100 text-start btn btn-link p-2 rounded {{if (eq this.activeGroup.key group.key) 'active'}}"
                {{on "click" (fn this.selectGroup group)}}
              >
                <div class="d-flex flex-column">
                  <span class="group-name">{{group.name}}</span>
                  <span class="group-meta text-muted small">
                    v{{group.version}}
                    {{#if group.range}}
                      · {{group.range}}
                    {{/if}}
                    · {{group.runs.length}} {{if (eq group.runs.length 1) "Lauf" "Läufe"}}
                  </span>
                </div>
              </button>
            </li>
          {{/each}}
        </ul>
        <div class="sidebar-foot text-muted small p-2 border-top">
          <FaIcon @icon="info-circle" />
          Läufe mit gleichen Szenariowerten werden gemittelt.
        </div>
      </nav>

      {{!-- Main content area --}}
      <div class="simulation-viewer-main flex-grow-1">
        {{#let this.activeGroup as |activeGroup|}}
          {{#if activeGroup}}
            {{!-- Runs bar --}}
            <div class="runs-bar mb-3 p-2 bg-light rounded d-flex flex-column gap-2">
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="runs-label fw-bold">
                  <FaIcon @icon="layer-group" /> Läufe
                </span>
                <div class="d-flex gap-1 flex-wrap">
                  {{#each (this.items activeGroup) as |run|}}
                    <button
                      type="button"
                      class="chip run-chip btn btn-sm {{if (this.isSelected activeGroup run) 'selected'}}"
                      style={{this.chipStyle run}}
                      title={{this.runTitle run}}
                      {{on "click" (fn this.toggleRun activeGroup run)}}
                    >
                      <span class="dot"></span>
                      <span class="chip-label">{{run.label}}</span>
                      {{#if run.isSet}}
                        <span class="chip-count">×{{run.n}}</span>
                      {{/if}}
                    </button>
                  {{/each}}
                </div>
                <button
                  type="button"
                  class="btn btn-sm btn-link p-0"
                  {{on "click" (fn this.selectAll activeGroup)}}
                >
                  Alle anzeigen
                </button>
              </div>

              <div class="runs-options d-flex align-items-center gap-3 flex-wrap small">
                {{#if (this.canAggregate activeGroup)}}
                  <label class="d-flex align-items-center gap-1 mb-0">
                    <input
                      type="checkbox"
                      class="form-check-input m-0"
                      checked={{this.isAggregated activeGroup}}
                      {{on "change" (fn this.toggleAggregate activeGroup)}}
                    />
                    Je Szenario mitteln
                  </label>
                  {{#if (this.isAggregated activeGroup)}}
                    <label class="d-flex align-items-center gap-1 mb-0">
                      Fläche:
                      <select class="form-select form-select-sm" {{on "change" this.setBand}}>
                        <option value="range" selected={{eq this.prefs.band "range"}}>Spannweite der Läufe</option>
                        <option value="ci" selected={{eq this.prefs.band "ci"}}>95-%-Intervall des Mittels</option>
                        <option value="none" selected={{eq this.prefs.band "none"}}>keine</option>
                      </select>
                    </label>
                  {{/if}}
                {{/if}}
                <label class="d-flex align-items-center gap-1 mb-0">
                  <input
                    type="checkbox"
                    class="form-check-input m-0"
                    checked={{this.prefs.yZero}}
                    {{on "change" (fn this.togglePref "yZero")}}
                  />
                  Y ab 0
                </label>
                <label class="d-flex align-items-center gap-1 mb-0">
                  <input
                    type="checkbox"
                    class="form-check-input m-0"
                    checked={{this.prefs.delta}}
                    {{on "change" (fn this.togglePref "delta")}}
                  />
                  Δ zum ersten gewählten Lauf
                </label>
                <span class="text-muted">
                  max. {{this.maxSelected}} Läufe gleichzeitig
                </span>
              </div>
            </div>

            {{!-- Scenario values that differ between the selected runs --}}
            {{#let (this.scenarioDiff activeGroup) as |diff|}}
              {{#if diff}}
                <div class="scenario-diff mb-3">
                  <h6>Szenariowerte</h6>
                  {{#if diff.rows.length}}
                    <div class="table-responsive">
                      <table class="table table-sm mb-0">
                        <thead>
                          <tr>
                            <th>Parameter</th>
                            {{#each diff.runs as |run|}}
                              <th style={{this.chipStyle run}}>
                                <span class="dot"></span>
                                {{run.label}}
                              </th>
                            {{/each}}
                          </tr>
                        </thead>
                        <tbody>
                          {{#each diff.rows as |row|}}
                            <tr>
                              <td>{{row.name}}</td>
                              {{#each row.cells as |cell|}}
                                <td class={{if cell.differs "differs"}}>{{cell.text}}</td>
                              {{/each}}
                            </tr>
                          {{/each}}
                        </tbody>
                      </table>
                    </div>
                  {{else}}
                    <p class="text-muted small mb-0">
                      Die gewählten Läufe haben identische Szenariowerte.
                    </p>
                  {{/if}}
                </div>
              {{/if}}
            {{/let}}

            {{!-- Charts grid --}}
            {{#let (this.chartNote activeGroup) as |note|}}
              {{#if note}}
                <p class="text-muted">{{note}}</p>
              {{else}}
                {{#let (this.groupNote activeGroup) as |groupNote|}}
                  {{#if groupNote}}
                    <p class="text-muted small">{{groupNote}}</p>
                  {{/if}}
                {{/let}}
                <div class="chart-sections">
                  {{#each activeGroup.variables as |variable|}}
                    <article class="card chart-card">
                      <header class="card-header d-flex justify-content-between align-items-center p-2">
                        <h6 class="mb-0" title={{variable.name}}>
                          {{variable.name}}
                          {{#if variable.unit}}
                            <span class="text-muted fw-normal">({{variable.unit}})</span>
                          {{/if}}
                        </h6>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-secondary p-1"
                          title="Als PNG speichern (16:9)"
                          {{on "click" (fn this.downloadPng variable activeGroup)}}
                        >
                          <FaIcon @icon="download" />
                        </button>
                      </header>
                      <div class="card-body p-2">
                        <div
                          class="chart-container"
                          {{echart (this.chartOption variable activeGroup)}}
                        ></div>
                      </div>
                    </article>
                  {{/each}}
                </div>
              {{/if}}
            {{/let}}
          {{/if}}
        {{/let}}
      </div>
    </div>
  {{/if}}
</div>
