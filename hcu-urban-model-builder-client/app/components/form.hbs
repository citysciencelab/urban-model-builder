<BsForm @model={{this.changeset.dataProxy}} @disabled={{@disabled}} as |form|>

  {{#if (eq this.type "node")}}
    <div class="sidebar">

      <Ui::SaveIndicator @isSaving={{this.changeset.isSaving}} />

      <div class="sidebar__header">
        {{#if this.canCollapseContainer}}
          <button
            type="button"
            class="sidebar__container-collapse btn btn-sm btn-outline-secondary
              {{if this.isContainerCollapsed '--collapsed'}}"
            disabled={{or @disabled this.changeset.isSaving}}
            title={{if this.isContainerCollapsed "Ausklappen" "Einklappen"}}
            aria-label={{if
              this.isContainerCollapsed
              "Ausklappen"
              "Einklappen"
            }}
            {{on "click" this.toggleContainerCollapsed}}
          >
            {{#if this.isContainerCollapsed}}
              <span
                class="sidebar__container-window-icon"
                aria-hidden="true"
              ></span>
            {{else}}
              <span
                class="sidebar__container-minus-icon"
                aria-hidden="true"
              >−</span>
            {{/if}}
          </button>
        {{/if}}
        {{#if this.hasErrors}}
          <BsAlert
            @type="danger"
            @dismissible={{false}}
            @visible={{this.hasErrors}}
          >
            {{t "messages.form_error"}}
          </BsAlert>
        {{/if}}
        {{#if this.primitiveTypeLabel}}
          <div class="sidebar__primitive-type">
            <SvgIcon @icon={{this.primitiveTypeIcon}} @size="xs" />
            <span>{{titleize this.primitiveTypeLabel}}</span>
          </div>
        {{/if}}
        <h4>
          <form.element
            @controlType="text"
            @placeholder={{t "models.nodes.attributes.name"}}
            @property="name"
            @customError={{get this.errors "name"}}
          />
        </h4>
        {{#if this.isGhostNode}}
          <div class="alert alert-warning alert-sm">
            {{! template-lint-disable no-bare-strings }}
            👻
            {{t "models.nodes.ghost_warning"}}
          </div>
        {{/if}}
      </div>
      <div
        class="sidebar__content"
        {{did-insert this.initialize}}
        {{did-update this.initialize @record}}
      >

        <form.element
          @controlType="textarea"
          @label={{t "models.nodes.attributes.description"}}
          @placeholder={{t "models.nodes.attributes.description"}}
          @property="description"
          @customError={{get this.errors "description"}}
        />

        {{#if this.nodeFormFieldsComponent}}
          <this.nodeFormFieldsComponent
            @form={{form}}
            @node={{this.record}}
            @modelsVersion={{@modelsVersion}}
            @changeset={{this.changeset}}
            @errors={{this.errors}}
            @disabled={{@disabled}}
          />
        {{/if}}

        {{#if this.modelValidationError}}
          <BsAlert
            class="node__validation-alert"
            @type="danger"
            @dismissible={{false}}
          >
            {{#if this.unitMismatchDetails}}
              <strong>{{t "messages.unit_mismatch.title"}}</strong>
              <div class="node__validation-unit-details">
                <span>
                  {{t "messages.unit_mismatch.incoming"}}:
                  <code>{{this.unitMismatchDetails.incoming}}</code>
                </span>
                <span>
                  {{t "messages.unit_mismatch.expected"}}:
                  <code>{{this.unitMismatchDetails.expected}}</code>
                </span>
                <small>{{t "messages.unit_mismatch.help"}}</small>
              </div>
            {{else}}
              <strong>Invalid variable or formula:</strong>
              {{this.modelValidationError}}
            {{/if}}
            {{#if this.generatedUnitsFix}}
              <button
                type="button"
                class="btn btn-sm btn-outline-danger node__validation-auto-fix"
                disabled={{or @disabled this.changeset.isSaving}}
                {{on "click" this.autoFixGeneratedUnits}}
              >
                {{t "actions.auto_fix_units"}}
              </button>
            {{/if}}
          </BsAlert>
        {{/if}}

        <div {{did-update this.onIsDirtyChanged this.isDirty}}></div>

        {{! DELETE Button }}
        <div class="node__delete-button-wrapper">
          <button
            type="button"
            class="btn btn-danger"
            disabled={{@disabled}}
            {{on "click" this.deleteNode}}
          >
            {{t "actions.delete"}}
          </button>
        </div>
      </div>
    </div>
  {{/if}}
</BsForm>