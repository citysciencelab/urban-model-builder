<div class="sidebar__header">
  <h4 class="mb-0">
    {{t "models.model.version_settings.title"}}
  </h4>

  <div class="sidebar__header__row">
    <Model::VersionSelect
      @model={{@modelVersion.model}}
      @currentVersion={{@modelVersion}}
    />
    {{! Badget: Latest }}
    {{#if @modelVersion.isLatest}}
      &nbsp;
      <span class="badge rounded-pill badge-success text-bg-light">
        {{t "components.share.latest"}}
      </span>
    {{/if}}
  </div>
</div>
<div class="sidebar__content">
  <div id="version-settings">

    <h5>
      {{t "models.model.version_settings.actions"}}
    </h5>
    {{! Action: New Draft }}
    <div class="actions">
      <a
        href="javascript:void(0)"
        class="action-item {{if @modelVersion.canCreateNewDraft '' 'disabled'}}"
        {{on "click" this.onCreateNewDraftVersion}}
      >
        <SvgIcon @icon="edit" @size="md" />
        <span>{{t "components.share.new_draft"}}</span>
      </a>
      {{! Action: Publish -> Dialog }}
      <a
        href="javascript:void(0)"
        class="action-item {{if @modelVersion.canPublish '' 'disabled'}}"
        {{on "click" this.modelDialogs.onStartPublish}}
      >
        <SvgIcon @icon="upload" @size="md" />
        <span>{{t "components.share.publish"}}</span>
      </a>
      {{! Action: Share -> Dialog }}
      <a
        href="javascript:void(0)"
        class="action-item {{if @modelVersion.canShare '' 'disabled'}}"
        {{on "click" this.modelDialogs.onStartShare}}
      >
        <SvgIcon @icon="share" @size="md" />
        <span>{{t "components.share.share"}}</span>
      </a>
      {{! Action: Clone -> Dialog }}
      <a
        href="javascript:void(0)"
        class="action-item"
        {{on "click" this.modelDialogs.onStartClone}}
      >
        <SvgIcon @icon="content_copy" @size="md" />
        <span>{{t "components.share.clone"}}</span>
      </a>
      <div class="actions__subgroup">
        <small class="actions__subgroup-label">{{t "components.share.file_transfer"}}</small>
        <a
          href="javascript:void(0)"
          class="action-item {{if @modelVersion.canShare '' 'disabled'}}"
          {{on "click" this.onExportModel}}
        >
          <SvgIcon @icon="file_download" @size="md" />
          <span>{{t "components.share.export_model"}}</span>
        </a>
        <a
          href="javascript:void(0)"
          class="action-item {{if @modelVersion.canEdit '' 'disabled'}}"
          {{on "click" this.onExportModelVersion}}
        >
          <SvgIcon @icon="file_download_outline" @size="md" />
          <span>{{t "components.share.export_model_version" version=@modelVersion.versionString}}</span>
        </a>
        <a
          href="javascript:void(0)"
          class="action-item {{if @modelVersion.canCreateNewDraft '' 'disabled'}}"
          {{on "click" this.triggerImport}}
        >
          <SvgIcon @icon="file_upload" @size="md" />
          <span>{{t "components.share.import_model_version" version=this.nextVersionString}}</span>
        </a>
      </div>
    </div>
    <input
      id={{this.importInputId}}
      type="file"
      accept="application/json,.json"
      hidden
      {{on "change" this.onImportFileSelected}}
    />
    {{#if this.isExporting}}
      <p class="text-muted mt-2 mb-0">
        {{t "components.share.exporting"}}
      </p>
    {{/if}}
    {{#if this.isImporting}}
      <p class="text-muted mt-2 mb-0">
        {{t "components.share.importing"}}
      </p>
    {{/if}}
    {{#if this.importExportError}}
      <p class="text-danger mt-2 mb-0">
        {{this.importExportError}}
      </p>
    {{/if}}
  </div>
</div>

<BsModal
  @open={{this.showImportConfirmModal}}
  @onSubmit={{this.onConfirmImport}}
  @onHide={{this.onCancelImport}}
  as |modal|
>
  <modal.header>
    <h5 class="modal-title">
      {{t "components.share.import_confirm_title"}}
    </h5>
  </modal.header>
  <modal.body>
    <p>
      {{t
        "components.share.import_confirm_body"
        version=this.nextVersionString
      }}
    </p>
  </modal.body>
  <modal.footer>
    <Ui::ModalButtons
      @onCancel={{this.onCancelImport}}
      @onSubmit={{this.onConfirmImport}}
      @cancelText={{t "actions.cancel"}}
      @submitText={{t "actions.import"}}
    />
  </modal.footer>
</BsModal>
