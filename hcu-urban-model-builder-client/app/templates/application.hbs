{{page-title (t "routes.application.title")}}

<div class="umb-shell {{if this.isEditor 'umb-shell--editor'}}">
  {{! The editor has no rail: its title block leads back to the Library. }}
  {{#unless this.isEditor}}
    <AppRail @onLogout={{this.invalidateSession}} />
  {{/unless}}

  <main>
    {{outlet}}
  </main>
</div>

<div id="ember-bootstrap-wormhole"></div>
<BasicDropdownWormhole />
