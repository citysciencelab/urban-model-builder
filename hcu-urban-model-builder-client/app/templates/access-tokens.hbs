{{page-title (t "routes.access_tokens.title")}}

<section class="umb-library umb-access">
  <header class="umb-library__head">
    <span class="umb-label">{{t "routes.access_tokens.eyebrow"}}</span>
    <h1 class="umb-library__title">{{t "routes.access_tokens.title"}}</h1>
    <p class="umb-access__lead">{{t "routes.access_tokens.intro"}}</p>
  </header>

  <section class="umb-access__section">
    <h2 class="umb-titel-m">{{t "routes.access_tokens.endpoint"}}</h2>
    <div class="umb-access__copy-row">
      <code class="umb-access__code" data-test-endpoint>{{this.mcpUrl}}</code>
      <button
        class="umb-btn umb-btn--sm"
        type="button"
        {{on "click" (fn this.copy "endpoint" this.mcpUrl)}}
      >
        <SvgIcon
          @icon={{if (eq this.copiedKey "endpoint") "check" "content_copy"}}
          @size="sm"
        />
        {{t
          (if
            (eq this.copiedKey "endpoint")
            "routes.access_tokens.copied"
            "routes.access_tokens.copy"
          )
        }}
      </button>
    </div>
  </section>

  {{#if this.oauthResource}}
    <section class="umb-access__section" data-test-oauth>
      <h2 class="umb-titel-m">{{t "routes.access_tokens.oauth_title"}}</h2>
      <p>{{t "routes.access_tokens.oauth_intro"}}</p>
      <p class="umb-meta">{{t "routes.access_tokens.oauth_note"}}</p>
    </section>
  {{/if}}

  <section class="umb-access__section">
    <h2 class="umb-titel-m">{{t "routes.access_tokens.tokens_title"}}</h2>
    <p>{{t "routes.access_tokens.tokens_intro"}}</p>

    {{#if this.hasError}}
      <div class="alert alert-danger" role="alert">
        {{t "routes.access_tokens.error"}}
      </div>
    {{/if}}

    {{#if this.createdToken}}
      <div class="umb-access__new" role="status" data-test-new-token>
        <span class="umb-label">{{t
            "routes.access_tokens.created_title"
          }}</span>
        <p>{{t "routes.access_tokens.created_notice"}}</p>
        <div class="umb-access__copy-row">
          <code class="umb-access__code">{{this.createdToken}}</code>
          <button
            class="umb-btn umb-btn--sm umb-btn--primary"
            type="button"
            {{on "click" (fn this.copy "token" this.createdToken)}}
          >
            <SvgIcon
              @icon={{if (eq this.copiedKey "token") "check" "content_copy"}}
              @size="sm"
            />
            {{t
              (if
                (eq this.copiedKey "token")
                "routes.access_tokens.copied"
                "routes.access_tokens.copy"
              )
            }}
          </button>
        </div>
      </div>
    {{/if}}

    {{#if this.rows.length}}
      <table class="umb-table">
        <thead>
          <tr>
            <th scope="col">{{t "routes.access_tokens.name"}}</th>
            <th scope="col">{{t "routes.access_tokens.token"}}</th>
            <th scope="col">{{t "routes.access_tokens.created"}}</th>
            <th scope="col">{{t "routes.access_tokens.expires"}}</th>
            <th scope="col">{{t "routes.access_tokens.last_used"}}</th>
            <th scope="col">
              <span class="visually-hidden">
                {{t "routes.access_tokens.revoke"}}
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {{#each this.rows key="token.id" as |row|}}
            <tr data-test-token-row>
              <td>{{row.token.name}}</td>
              <td class="umb-value">{{row.maskedToken}}</td>
              <td class="umb-meta">{{format-date row.token.createdAt}}</td>
              <td class="umb-meta">
                {{#if row.isExpired}}
                  <span class="umb-chip umb-chip--draft">
                    {{t "routes.access_tokens.expired"}}
                  </span>
                {{else}}
                  {{format-date row.token.expiresAt}}
                {{/if}}
              </td>
              <td class="umb-meta">
                {{#if row.token.lastUsedAt}}
                  {{format-date row.token.lastUsedAt}}
                {{else}}
                  {{t "routes.access_tokens.never_used"}}
                {{/if}}
              </td>
              <td class="umb-table__actions">
                <button
                  class="umb-btn umb-btn--sm"
                  type="button"
                  {{on "click" (fn this.revokeToken row.token)}}
                >
                  {{t "routes.access_tokens.revoke"}}
                </button>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p class="umb-meta" data-test-no-tokens>
        {{t "routes.access_tokens.no_tokens"}}
      </p>
    {{/if}}

    <form class="umb-access__form" {{on "submit" this.createToken}}>
      <div class="umb-access__field umb-access__field--grow">
        <label class="form-label" for="access-tokens-name">
          {{t "routes.access_tokens.name"}}
        </label>
        <input
          id="access-tokens-name"
          class="form-control"
          type="text"
          maxlength="255"
          placeholder={{t "routes.access_tokens.name_placeholder"}}
          value={{this.name}}
          {{on "input" this.onNameInput}}
        />
      </div>
      <div class="umb-access__field">
        <label class="form-label" for="access-tokens-lifetime">
          {{t "routes.access_tokens.validity"}}
        </label>
        <select
          id="access-tokens-lifetime"
          class="form-select"
          {{on "change" this.onLifetimeChange}}
        >
          {{#each this.lifetimes as |days|}}
            <option value={{days}} selected={{eq days this.expiresInDays}}>
              {{t "routes.access_tokens.days" days=days}}
            </option>
          {{/each}}
        </select>
      </div>
      <button
        class="umb-btn umb-btn--primary"
        type="submit"
        disabled={{not this.canCreate}}
      >
        {{t "routes.access_tokens.create"}}
      </button>
    </form>
  </section>

  <section class="umb-access__section">
    <h2 class="umb-titel-m">{{t "routes.access_tokens.setup_title"}}</h2>
    {{#unless this.createdToken}}
      <p class="umb-meta">
        {{t "routes.access_tokens.setup_placeholder_notice"}}
      </p>
    {{/unless}}

    <p>{{t "routes.access_tokens.setup_claude_code"}}</p>
    <div class="umb-access__copy-row umb-access__copy-row--top">
      <pre class="umb-access__code">{{this.claudeCodeCommand}}</pre>
      <button
        class="umb-btn umb-btn--sm"
        type="button"
        {{on "click" (fn this.copy "claude-code" this.claudeCodeCommand)}}
      >
        <SvgIcon
          @icon={{if (eq this.copiedKey "claude-code") "check" "content_copy"}}
          @size="sm"
        />
        {{t
          (if
            (eq this.copiedKey "claude-code")
            "routes.access_tokens.copied"
            "routes.access_tokens.copy"
          )
        }}
      </button>
    </div>

    <p>{{t "routes.access_tokens.setup_json"}}</p>
    <div class="umb-access__copy-row umb-access__copy-row--top">
      <pre class="umb-access__code">{{this.jsonConfig}}</pre>
      <button
        class="umb-btn umb-btn--sm"
        type="button"
        {{on "click" (fn this.copy "json" this.jsonConfig)}}
      >
        <SvgIcon
          @icon={{if (eq this.copiedKey "json") "check" "content_copy"}}
          @size="sm"
        />
        {{t
          (if
            (eq this.copiedKey "json")
            "routes.access_tokens.copied"
            "routes.access_tokens.copy"
          )
        }}
      </button>
    </div>

    {{#unless this.oauthResource}}
      <p class="umb-meta" data-test-no-oauth>
        {{t "routes.access_tokens.setup_limitation"}}
      </p>
    {{/unless}}
  </section>
</section>