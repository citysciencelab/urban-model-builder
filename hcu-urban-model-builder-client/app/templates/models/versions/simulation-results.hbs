{{page-title "Simulationsergebnisse"}}

<div class="simulation-results-page">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <BreadcrumbsItem>
        {{this.model.modelsVersions.model.internalName}}
      </BreadcrumbsItem>
      <BreadcrumbsItem>
        Version {{this.model.majorVersion}}.{{this.model.minorVersion}}.{{this.model.draftVersion}}
      </BreadcrumbsItem>
      <BreadcrumbsItem>
        Simulationsergebnisse
      </BreadcrumbsItem>
    </div>
    
    <div class="page-header-actions d-flex gap-2">
      <LinkTo @route="models.versions.show" @model={{this.model}} class="btn btn-outline-secondary">
        <FaIcon @icon="arrow-left" /> Zurück zum Modell
      </LinkTo>
      <button type="button" class="btn btn-primary" {{on "click" this.loadSimulationResults}}>
        <FaIcon @icon="sync-alt" /> Aktualisieren
      </button>
    </div>
  </div>

  <SimulationViewer @model={{this.model}} />
</div>
